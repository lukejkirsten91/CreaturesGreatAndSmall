{
  "name": "creatures-great-and-small",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-images.mjs && next dev",
    "build": "node scripts/prepare-images.mjs && next build && node scripts/finalize-static.mjs && node scripts/verify-static.mjs",
    "start": "node scripts/serve.mjs",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "verify:static": "node scripts/verify-static.mjs"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "next": "15.5.28",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "postcss": "8.5.31",
    "sharp": "0.35.5",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp",
    "nanoid": "^3.3.20",
    "source-map-js": "^1.2.2"
  },
  "engines": { "node": "22.x" }
}
